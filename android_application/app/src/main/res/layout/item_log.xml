<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogEndpoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/api/intel/lookup"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Platform: Android App | Sent: 420B, Recv: 1.84KB"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvLogStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_clean"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="Clean"
        android:textColor="@color/status_clean"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
